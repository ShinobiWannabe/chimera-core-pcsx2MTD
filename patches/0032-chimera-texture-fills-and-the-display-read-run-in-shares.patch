new file mode 100644
index 0000000..f518387
--- /dev/null
+++ b/pcsx2/GS/ChimeraParallel.h
@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: 2002-2025 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+#pragma once
+
+/* Chimera: split a loop into a fixed number of shares and run them on
+ * miniBox's parallel tasks (wbx_parallel_for). The number of shares never
+ * depends on how many workers the host has, and each share writes only its
+ * own part of the output, so the bytes are the same at every worker count.
+ * With no host support (native builds, or 0 workers) the shares run here, in
+ * order.
+ *
+ * A share must not make a system call, allocate, touch thread-local state, or
+ * change the floating point control word. */
+
+#include <cstdint>
+#include <waterbox_parallel.h>
+
+namespace chimera_par
+{
+	template <typename F>
+	struct Job
+	{
+		const F* fn;
+		int n;
+		int shares;
+	};
+
+	template <typename F>
+	void RunShare(void* arg, uint32_t share)
+	{
+		const Job<F>* job = static_cast<const Job<F>*>(arg);
+		const int a = static_cast<int>((static_cast<long long>(job->n) * share) / job->shares);
+		const int b = static_cast<int>((static_cast<long long>(job->n) * (share + 1)) / job->shares);
+		/* a copy on this task's stack keeps the captures in registers */
+		F local = *job->fn;
+		for (int i = a; i < b; i++)
+			local(i);
+	}
+
+	/* fn(i) for every i in [0, n). Below min_split items it runs here. */
+	template <typename F>
+	void For(int n, int shares, int min_split, const F& fn)
+	{
+		if (n < min_split || shares <= 1)
+		{
+			F local = fn;
+			for (int i = 0; i < n; i++)
+				local(i);
+			return;
+		}
+		Job<F> job{&fn, n, shares};
+		wbx_parallel_for(&RunShare<F>, &job, static_cast<uint32_t>(shares));
+	}
+} // namespace chimera_par
