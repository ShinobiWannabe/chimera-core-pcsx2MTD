+/* Chimera: read a block-aligned rect of GS memory for display in fixed shares
+ * of block rows. Each block row lands in its own rows of dst. */
+static void ChimeraReadRect(GSLocalMemory::readTexture rtx, GSLocalMemory& mem, const GSOffset& off,
+	const GSVector4i& r, u8* dst, int pitch, const GIFRegTEXA& texa, int bsy)
+{
+	const int rows = (r.bottom - r.top) / bsy;
+	if (rows <= 0 || rows * bsy != r.bottom - r.top)
+	{
+		rtx(mem, off, r, dst, pitch, texa);
+		return;
+	}
+	GSLocalMemory* memp = &mem;
+	const GSOffset offc = off;
+	const GSVector4i rc = r;
+	const GIFRegTEXA texac = texa;
+	chimera_par::For(rows, 8, 16, [=](int k) {
+		const GSVector4i sub(rc.left, rc.top + k * bsy, rc.right, rc.top + (k + 1) * bsy);
+		rtx(*memp, offc, sub, dst + static_cast<size_t>(k) * bsy * pitch, pitch, texac);
+	});
+}
