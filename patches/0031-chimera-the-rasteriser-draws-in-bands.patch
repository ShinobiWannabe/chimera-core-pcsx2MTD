+#ifdef CHIMERA_BAND_RASTERIZER
+/* chimeraMTD (phase 1b): the rasteriser in fixed bands on miniBox's parallel
+ * tasks.
+ *
+ * GSRasterizerList's design, without its threads: kBands rasterisers, each
+ * owning every kBands-th group of 16 scanlines, as upstream's workers do. Draws
+ * are set up and queued on the GS's own thread and drawn at a flush, which is
+ * one wbx_parallel_for with one task per band; each task draws every queued
+ * draw that reaches its band, in queue order. A pixel belongs to exactly one
+ * band and is drawn in the order the GS was given, so the picture cannot depend
+ * on how many workers the host has. The band count is part of the machine; the
+ * worker count is not.
+ *
+ * A flush happens wherever upstream would Sync (a draw that reads or overlaps
+ * pages still being drawn, a transfer, vsync, a state) and when the queue is
+ * full. Nothing a task does reaches the queue or the ring heap: the draws are
+ * let go of here, after the join. */
+class GSBandRasterizer final : public IRasterizer
+{
+public:
+	static constexpr int kBands = 8;
+	static constexpr size_t kMaxQueued = 512;
+
+	GSBandRasterizer();
+	~GSBandRasterizer() override;
+
+	void Queue(const GSRingHeap::SharedPtr<GSRasterizerData>& data) override;
+	void Sync() override;
+	bool IsSynced() const override;
+	int GetPixels(bool reset = true) override;
+	void PrintStats() override;
+
+private:
+	static void DrawBand(void* self, u32 band);
+
+	GSDrawScanline m_ds;
+	std::unique_ptr<GSRasterizer> m_r[kBands];
+	std::vector<GSRingHeap::SharedPtr<GSRasterizerData>> m_queue;
+	int m_thread_height;
+};
+#endif
