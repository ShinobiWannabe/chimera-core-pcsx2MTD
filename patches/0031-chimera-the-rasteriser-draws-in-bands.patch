+#ifdef CHIMERA_BAND_RASTERIZER
+GSBandRasterizer::GSBandRasterizer()
+{
+	for (int i = 0; i < kBands; i++)
+		m_r[i] = std::make_unique<GSRasterizer>(&m_ds, i, kBands);
+	m_thread_height = compute_best_thread_height(kBands);
+	m_queue.reserve(kMaxQueued);
+}
+
+GSBandRasterizer::~GSBandRasterizer()
+{
+	Sync();
+}
+
+void GSBandRasterizer::Queue(const GSRingHeap::SharedPtr<GSRasterizerData>& data)
+{
+	if (!m_ds.SetupDraw(*data.get())) [[unlikely]]
+	{
+		Sync();
+		m_ds.ResetCodeCache();
+		m_ds.SetupDraw(*data.get());
+	}
+
+	m_queue.push_back(data);
+	if (m_queue.size() >= kMaxQueued)
+		Sync();
+}
+
+void GSBandRasterizer::DrawBand(void* self, u32 band)
+{
+	GSBandRasterizer* const t = static_cast<GSBandRasterizer*>(self);
+	GSRasterizer& r = *t->m_r[band];
+	const int h = t->m_thread_height;
+	for (const GSRingHeap::SharedPtr<GSRasterizerData>& item : t->m_queue)
+	{
+		GSRasterizerData& data = *item.get();
+		// does this draw reach any scanline group this band owns?
+		const GSVector4i rc = data.bbox.rintersect(data.scissor);
+		int top = rc.top >> h;
+		const int bottom = (rc.bottom + (1 << h) - 1) >> h;
+		bool mine = false;
+		for (; top < bottom; top++)
+		{
+			if (top % kBands == static_cast<int>(band))
+			{
+				mine = true;
+				break;
+			}
+		}
+		if (mine)
+			r.Draw(data);
+	}
+}
+
+void GSBandRasterizer::Sync()
+{
+	if (m_queue.empty())
+		return;
+	wbx_parallel_for(&GSBandRasterizer::DrawBand, this, kBands);
+	// let go of the draws here, on the GS's thread: the ring heap and the
+	// renderer's page counts are touched by nobody else
+	m_queue.clear();
+	g_perfmon.Put(GSPerfMon::SyncPoint, 1);
+}
+
+bool GSBandRasterizer::IsSynced() const
+{
+	return m_queue.empty();
+}
+
+int GSBandRasterizer::GetPixels(bool reset)
+{
+	int pixels = 0;
+	for (int i = 0; i < kBands; i++)
+		pixels += m_r[i]->GetPixels(reset);
+	return pixels;
+}
+
+void GSBandRasterizer::PrintStats()
+{
+}
