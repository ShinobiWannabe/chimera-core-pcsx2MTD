@@ -187,7 +187,15 @@ private:
 class GSBandRasterizer final : public IRasterizer
 {
 public:
-	static constexpr int kBands = 8;
+	/* how many bands, and how tall a strip each owns (CHIMERA_RASTER_HEIGHT,
